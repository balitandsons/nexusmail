# Copy to .env. If ADMIN_PASSWORD is empty a random one is generated and printed on first start.
ADMIN_PASSWORD=change-me-to-something-long
PORT=3000
# Daily mailbox limits reset at midnight in this timezone
APP_TIMEZONE=Asia/Kolkata
# Set to 1 behind Nginx/Caddy with HTTPS
TRUST_PROXY=0
RESUME_ON_START=true

# AI inbox (Gemini). Without a key a simple keyword classifier is used instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
