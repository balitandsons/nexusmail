{
  "name": "nexusmail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-provider bulk mailer (Hostinger, Brevo, ZeptoMail, SMTP) with AI omnichannel inbox",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/test/*.test.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start:prod": "node app.mjs",
    "package:hostinger": "node scripts/package-hostinger.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.25.0",
    "express": "^4.21.2",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
